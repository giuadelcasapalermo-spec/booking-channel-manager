# Booking.com Connectivity API credentials
# Ottenibili dal Connectivity Portal: https://connect.booking.com

BOOKING_USERNAME=           # Machine account username
BOOKING_PASSWORD=           # Machine account password
BOOKING_TOKEN=              # Short-lived JWT token (se usi token auth)

# Hotel/proprietà
BOOKING_HOTEL_ID=           # ID hotel su Booking.com
BOOKING_ROOM_ID=            # ID camera/room type su Booking.com
BOOKING_RATE_PLAN_ID=       # ID rate plan su Booking.com

# Endpoint (non modificare in produzione)
BOOKING_ARI_BASE=https://supply-xml.booking.com
BOOKING_RES_BASE=https://secure-supply-xml.booking.com

# Modalità mock (true = non chiama API reali, usa dati finti)
BOOKING_MOCK_MODE=true

# Polling intervallo prenotazioni (secondi, minimo 20 per policy Booking)
RESERVATION_POLL_INTERVAL_S=20
